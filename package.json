{
  "name": "ecommerce-home",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx watch worker/index.ts",
    "worker:start": "tsx worker/index.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "owner:create": "tsx scripts/create-owner.ts",
    "catalog:resync": "tsx --conditions=react-server scripts/resync-catalog.ts",
    "load:prepare": "tsx --conditions=react-server scripts/load/prepare.ts",
    "load:run": "k6 run scripts/load/storefront.js",
    "load:cleanup": "tsx --conditions=react-server scripts/load/cleanup.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@node-rs/argon2": "^2.2.2",
    "@react-email/components": "1.0.12",
    "better-auth": "^1.7.25",
    "bullmq": "^6.7.7",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "cn": "^0.5.2",
    "gsap": "^3.15.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.75.0",
    "mongodb": "^7.9.0",
    "mongoose": "^9.12.2",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "nodemailer": "^10.6.0",
    "pino": "^10.4.0",
    "playwright-core": "^1.65.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  }
}
