# Production settings for deploy/compose.yml. Copy to deploy/.env.production and fill in.
# Never commit the filled-in file. Generate secrets with:  openssl rand -base64 32

# ---- The shop ----
APP_URL=https://shop.example.com
DOMAIN=shop.example.com
STORE_NAME=China Import Store
# Email for Let's Encrypt certificate notices.
ACME_EMAIL=you@example.com
# SEARCH_INDEXING=off   # only on a staging copy

# ---- Database (MongoDB in Docker) ----
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change-me-long-random
MONGO_APP_DB=ecommerce
MONGO_APP_USER=shop
MONGO_APP_PASSWORD=change-me-long-random
# The app inside Docker, and the build on the server itself. Same user and password as above.
MONGODB_URI=mongodb://shop:change-me-long-random@mongo:27017/ecommerce?authSource=ecommerce&replicaSet=rs0
MONGODB_BUILD_URI=mongodb://shop:change-me-long-random@127.0.0.1:27017/ecommerce?authSource=ecommerce&directConnection=true

# ---- Redis ----
REDIS_PASSWORD=change-me-long-random
REDIS_URL=redis://:change-me-long-random@redis:6379
REDIS_BUILD_URL=redis://:change-me-long-random@127.0.0.1:6379

# ---- Secrets (each: openssl rand -base64 32) ----
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
REVALIDATE_SECRET=

# ---- Email and SMS (or set them later in Admin → Integrations) ----
EMAIL_PROVIDER=smtp
EMAIL_FROM=China Import Store <no-reply@shop.example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMS_PROVIDER=console
# ALPHA_SMS_API_KEY=

# ---- Media (Cloudinary; uploads don't work in production without it) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Google sign-in (optional) ----
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- Error tracking (Sentry, optional): the project's DSN, in both lines ----
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info
