# Caddy: HTTPS certificates (Let's Encrypt, renewed automatically) and the way in to the shop.
# DOMAIN comes from .env.production, e.g. shop.example.com (or a DuckDNS name before you have a domain).
{
	email {$ACME_EMAIL}
	servers {
		# Behind Cloudflare, the visitor's real address arrives in CF-Connecting-IP. Only Cloudflare's own
		# servers are believed (list from https://www.cloudflare.com/ips/, checked 2026-11); anyone else
		# sending that header is ignored, so per-IP limits can't be dodged.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$DOMAIN} {
	encode zstd gzip

	reverse_proxy web:3000 {
		# The app reads the visitor's address only from here (CLIENT_IP_HEADER=x-real-ip).
		header_up X-Real-IP {client_ip}
		header_up -X-Forwarded-For
	}

	# Access logs are off on purpose: they would hold visitors' addresses (NFR-AV-03).
	log {
		output stderr
		level ERROR
	}
}

# www → the main address
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
