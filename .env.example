# Copy to .env.local for development:  cp .env.example .env.local
# Never commit real secrets. Generate secrets with:  openssl rand -base64 32

APP_URL=http://localhost:3000
STORE_NAME="China Import Store"

# Local services from docker-compose.yml (pnpm services:up)
MONGODB_URI=mongodb://localhost:27018/ecommerce?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379

# Auth: at least 32 characters, random
BETTER_AUTH_SECRET=
# Encrypts integration keys saved in admin: base64 of 32 random bytes
ENCRYPTION_KEY=
# Lets scripts and the worker refresh store pages (POST /api/internal/revalidate); empty = off
REVALIDATE_SECRET=

# Google sign-in (optional in development). Redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Header your reverse proxy sets with the real client IP (Cloudflare: cf-connecting-ip)
CLIENT_IP_HEADER=x-forwarded-for

# Email. Development uses Mailpit (inbox at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="China Import Store <no-reply@localhost>"
# "smtp" (the settings above: Mailpit locally; Amazon SES and Brevo also give SMTP settings) or
# "resend" (Resend's API). In production send from a subdomain such as mail.yourshop.com with SPF,
# DKIM and DMARC set up.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=

# SMS: "console" prints messages (including OTP codes) in the worker log
SMS_PROVIDER=console
# Production: SMS_PROVIDER=alpha (Alpha SMS, sms.net.bd, BTRC-listed) with its API key.
# SMS_FALLBACK_PROVIDER=        # optional second provider, tried when the first one fails
# SMS_SENDER_ID=                # approved masking name; empty = numeric sender
# ALPHA_SMS_API_KEY=

# Media storage (Cloudinary). Uploads are disabled until these are set.
# Invoice PDFs are printed by Chrome/Chromium. Unset = the Google Chrome on this computer.
# Production image: install chromium and set its path, e.g. CHROMIUM_PATH=/usr/bin/chromium
CHROMIUM_PATH=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

LOG_LEVEL=info
